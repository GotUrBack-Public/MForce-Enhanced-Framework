#!/usr/bin/env bash
# External tool registry and safe process adapter. Source after runtime.sh.
MF_TOOL_CATALOG="${MF_ROOT}/src/tools/catalog.json"
MF_TOOL_IDS=()
MF_TOOL_NAMES=()
MF_TOOL_COMMANDS=()
MF_TOOL_CATEGORIES=()
MF_TOOL_DESCRIPTIONS=()
MF_TOOL_ENABLED=()
MF_TOOL_PACKAGES=()

mf_tools_validate() {
    local file="${1:-$MF_TOOL_CATALOG}"
    mf_require_json "$file" tools || return 1
    jq -e '
      .schema_version == 1 and
      (.tools | type == "array") and
      ([.tools[] | select(
        (.id | type == "string" and test("^[a-z][a-z0-9_-]{1,39}$")) and
        (.name | type == "string" and length > 0 and length <= 80) and
        (.command | type == "string" and test("^[A-Za-z0-9_.+-]+$")) and
        (.category | type == "string" and length > 0 and length <= 40) and
        (.description | type == "string" and length <= 240) and
        (.enabled | type == "boolean") and
        ((.packages // {}) | type == "object" and all(.[]; type == "array" and all(.[]; type == "string" and test("^[A-Za-z0-9][A-Za-z0-9+_.-]*$"))))
      )] | length) == (.tools | length) and
      ([.tools[].id] | length == (unique | length))
    ' "$file" >/dev/null 2>&1 || {
        printf 'ERROR: Invalid external tool catalog: %s\n' "$file" >&2
        return 1
    }
}

mf_tools_load() {
    local file="${1:-$MF_TOOL_CATALOG}" id name binary category description enabled
    mf_tools_validate "$file" || return 1
    MF_TOOL_IDS=() MF_TOOL_NAMES=() MF_TOOL_COMMANDS=()
    MF_TOOL_CATEGORIES=() MF_TOOL_DESCRIPTIONS=() MF_TOOL_ENABLED=() MF_TOOL_PACKAGES=()
    while IFS=$'\t' read -r id name binary category description enabled; do
        [[ -n "$id" ]] || continue
        MF_TOOL_IDS+=("$id")
        MF_TOOL_NAMES+=("$name")
        MF_TOOL_COMMANDS+=("$binary")
        MF_TOOL_CATEGORIES+=("$category")
        MF_TOOL_DESCRIPTIONS+=("$description")
        MF_TOOL_ENABLED+=("$enabled")
        MF_TOOL_PACKAGES+=("$(jq -c --arg id "$id" '.tools[] | select(.id == $id) | .packages // {}' "$file")")
    done < <(jq -r '.tools[] | [.id,.name,.command,.category,.description,.enabled] | @tsv' "$file")
}

mf_tool_available() {
    local tool_id="$1" i
    for i in "${!MF_TOOL_IDS[@]}"; do
        if [[ "${MF_TOOL_IDS[$i]}" == "$tool_id" ]]; then
            [[ "${MF_TOOL_ENABLED[$i]}" == true ]] || return 1
            type -P -- "${MF_TOOL_COMMANDS[$i]}" >/dev/null 2>&1
            return $?
        fi
    done
    return 1
}

# Invoke only a registered, enabled executable. Arguments remain an argv array;
# no eval, command-string parsing, or implicit shell expansion is performed.
mf_tool_run() {
    local tool_id="$1" i binary executable
    shift
    for i in "${!MF_TOOL_IDS[@]}"; do
        [[ "${MF_TOOL_IDS[$i]}" == "$tool_id" ]] || continue
        [[ "${MF_TOOL_ENABLED[$i]}" == true ]] || {
            printf 'ERROR: Tool is disabled: %s\n' "$tool_id" >&2; return 1;
        }
        binary="${MF_TOOL_COMMANDS[$i]}"
        executable="$(type -P -- "$binary")" || executable=''
        [[ -n "$executable" ]] || {
            printf 'ERROR: Required program is not installed: %s\n' "$binary" >&2; return 127;
        }
        "$executable" "$@"
        return $?
    done
    printf 'ERROR: Tool is not registered: %s\n' "$tool_id" >&2
    return 1
}

mf_tool_package_manager() {
    if [[ -n "${PREFIX:-}" && -x "${PREFIX}/bin/pkg" ]]; then printf 'termux'
    elif command -v apt-get >/dev/null 2>&1; then printf 'apt'
    elif command -v dnf >/dev/null 2>&1; then printf 'dnf'
    elif command -v zypper >/dev/null 2>&1; then printf 'zypper'
    elif command -v pacman >/dev/null 2>&1; then printf 'pacman'
    elif command -v apk >/dev/null 2>&1; then printf 'apk'
    else return 1; fi
}
mf_tools_sync_dependencies() {
    local manager privilege='' i package command_name package_json
    local -a packages=() missing=()
    manager="$(mf_tool_package_manager)" || { printf 'No supported package manager detected.\n' >&2; return 1; }
    for i in "${!MF_TOOL_IDS[@]}"; do
        [[ "${MF_TOOL_ENABLED[$i]}" == true ]] || continue
        package_json="${MF_TOOL_PACKAGES[$i]:-{}}"
        command_name="${MF_TOOL_COMMANDS[$i]}"
        while IFS= read -r package; do
            [[ -n "$package" ]] || continue
            packages+=("$package")
            type -P -- "$command_name" >/dev/null 2>&1 || missing+=("$package")
        done < <(jq -r --arg manager "$manager" '.[$manager] // [] | .[]' <<< "$package_json")
    done
    ((${#packages[@]})) || { printf 'No package mappings configured for %s.\n' "$manager"; return 0; }
    if [[ "$manager" != termux && "$EUID" -ne 0 ]]; then
        command -v sudo >/dev/null 2>&1 || { printf 'ERROR: sudo is required for package management.\n' >&2; return 1; }
        privilege='sudo'
    fi
    printf 'Checking/updating dependencies for all enabled tools using %s...\n' "$manager"
    case "$manager" in
        termux) pkg update -y && pkg upgrade -y && pkg install -y "${packages[@]}" ;;
        apt) $privilege apt-get update || return 1; if ((${#missing[@]})); then $privilege apt-get install -y "${packages[@]}"; else $privilege apt-get install -y --only-upgrade "${packages[@]}"; fi ;;
        dnf) if ((${#missing[@]})); then $privilege dnf install -y "${packages[@]}"; else $privilege dnf upgrade -y "${packages[@]}"; fi ;;
        zypper) $privilege zypper --non-interactive refresh || return 1; if ((${#missing[@]})); then $privilege zypper --non-interactive install "${packages[@]}"; else $privilege zypper --non-interactive update "${packages[@]}"; fi ;;
        pacman) $privilege pacman -Syu --noconfirm --needed "${packages[@]}" ;;
        apk) $privilege apk update || return 1; if ((${#missing[@]})); then $privilege apk add "${packages[@]}"; else $privilege apk upgrade "${packages[@]}"; fi ;;
    esac
}
