#!/usr/bin/env bash
ROOT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd)"
source "$ROOT_DIR/src/core/runtime.sh" || exit 1
source "$ROOT_DIR/src/ui/theme.lib" || exit 1
source "$ROOT_DIR/src/core/tool_manager.lib" || exit 1
source "$ROOT_DIR/src/tools/nmap.lib" || exit 1

SELECTED=0
MENU_ITEMS=()
NMAP_PROFILE_INDEX=0
NMAP_PROFILES=(discovery quick services)
NMAP_PROFILE_NAMES=('Host discovery' 'Quick TCP scan' 'Service detection')
NMAP_PROFILE_NOTES=('Check if the host responds' 'Scan common TCP ports' 'Identify services on top 100 TCP ports')

refresh_tools() {
    mf_tools_load || return 1
    MENU_ITEMS=()
    local i
    for i in "${!MF_TOOL_IDS[@]}"; do MENU_ITEMS+=("${MF_TOOL_NAMES[$i]}"); done
    MENU_ITEMS+=('Refresh tool detection' 'Keyboard help' 'Exit MForce')
    ((SELECTED < ${#MENU_ITEMS[@]})) || SELECTED=0
}

mf_tool_ui_raw() {
    hide_cursor
    stty -echo -icanon min 1 time 0 2>/dev/null || :
}

draw_catalog() {
    local i status note
    mf_ui_header 'TOOL MANAGER' "$(mf_ui_platform) / EXTERNAL TOOLS"
    mf_ui_text 'Choose a tool. MForce handles the interface; tools run separately.' bright
    mf_ui_gap
    mf_ui_section 'AVAILABLE TOOLS'
    if (("${#MF_TOOL_IDS[@]}" == 0)); then
        mf_ui_status 'No external tools are registered.' warning
    else
        for i in "${!MF_TOOL_IDS[@]}"; do
            status='NOT INSTALLED'
            note="${MF_TOOL_COMMANDS[$i]} / ${MF_TOOL_CATEGORIES[$i]}"
            if [[ "${MF_TOOL_ENABLED[$i]}" != true ]]; then status='DISABLED'
            elif mf_tool_available "${MF_TOOL_IDS[$i]}"; then status='READY'
            fi
            mf_ui_row "$((i+1))" "${MF_TOOL_NAMES[$i]}" "$status  |  $note" "$((SELECTED == i))"
        done
    fi
    mf_ui_gap
    mf_ui_section 'MANAGER'
    local offset=${#MF_TOOL_IDS[@]}
    mf_ui_row "$((offset+1))" 'Refresh tool detection' 'Recheck installed programs' "$((SELECTED == offset))"
    mf_ui_row "$((offset+2))" 'Keyboard help' 'Navigation shortcuts' "$((SELECTED == offset+1))"
    mf_ui_row "$((offset+3))" 'Exit MForce' 'Close the current session' "$((SELECTED == offset+2))"
    mf_ui_footer 'ARROWS / J K  Navigate  |  ENTER  Select  |  Q  Exit' 'ARROWS  ENTER  Q EXIT'
}

show_nmap_missing() {
    mf_ui_header 'NMAP' 'INSTALLATION REQUIRED'
    mf_ui_status 'Nmap was not found on PATH.' warning
    if mf_is_termux; then
        mf_ui_text 'Install with: pkg install nmap' bright
    else
        mf_ui_text 'Debian / Ubuntu: sudo apt install nmap' bright
        mf_ui_text 'Other systems: use your distribution package manager.'
    fi
    mf_ui_text 'After installation, choose Refresh tool detection.'
    mf_ui_footer 'Q / ENTER  Back to tool manager' 'Q / ENTER  BACK'
    while :; do
        mf_read_key BACK
        case "$MF_KEY" in BACK|ENTER|EOF) return 0 ;; HELP) mf_ui_help ;; esac
    done
}

run_nmap_profile() {
    local profile="$1" target status
    mf_restore_terminal
    mf_ui_header 'NMAP' 'TARGET INPUT'
    mf_ui_text 'Enter one IP address or hostname that you are authorized to scan.' warn
    mf_ui_text 'CIDR ranges, wildcards and command arguments are not accepted.'
    printf '\n  Target: '
    IFS= read -r target || target=''
    if [[ -z "$target" ]]; then
        mf_tool_ui_raw
        return 0
    fi
    if ! mf_nmap_validate_target "$target"; then
        mf_ui_status 'Invalid target. Enter one IP address or hostname.' warning
        mf_ui_footer 'Press ENTER to return' 'ENTER  BACK'
        IFS= read -r _
        mf_tool_ui_raw
        return 0
    fi
    mf_ui_header 'NMAP' 'AUTHORIZED USE ONLY'
    mf_ui_field 'Target' "$target"
    mf_ui_field 'Profile' "$profile"
    mf_ui_text 'Only continue if you own this system or have explicit permission.' warn
    mf_ui_footer 'ENTER  Start scan  |  Q  Cancel' 'ENTER START  Q CANCEL'
    mf_read_key BACK
    if [[ "$MF_KEY" != ENTER ]]; then
        mf_tool_ui_raw
        return 0
    fi
    mf_restore_terminal
    mf_ui_header 'NMAP' 'SCAN RUNNING'
    mf_ui_field 'Target' "$target"
    mf_ui_text 'Press Ctrl+C to stop the scan.'
    printf '\n'
    mf_nmap_run "$profile" "$target"
    status=$?
    printf '\n'
    if ((status == 0)); then
        mf_ui_status 'Nmap finished.' ready
    else
        mf_ui_status "Nmap exited with status $status." warning
    fi
    printf '  Press Enter to return to MForce...'
    IFS= read -r _
    mf_tool_ui_raw
}

show_nmap_profiles() {
    local selected=0
    if ! mf_tool_available nmap; then
        show_nmap_missing
        return 0
    fi
    while :; do
        mf_ui_header 'NMAP' 'SCAN PROFILE'
        mf_ui_text 'Select a fixed scan profile. No command flags need to be typed.' bright
        mf_ui_gap
        local i
        for i in "${!NMAP_PROFILES[@]}"; do
            mf_ui_row "$((i+1))" "${NMAP_PROFILE_NAMES[$i]}" "${NMAP_PROFILE_NOTES[$i]}" "$((selected == i))"
        done
        mf_ui_footer 'ARROWS / J K  Select  |  ENTER  Continue  |  Q  Back' 'ARROWS ENTER Q BACK'
        mf_read_key BACK
        case "$MF_KEY" in
            UP) ((selected=(selected+2)%3)) ;;
            DOWN) ((selected=(selected+1)%3)) ;;
            HOME) selected=0 ;;
            END) selected=2 ;;
            HELP) mf_ui_help ;;
            BACK|EOF) return 0 ;;
            ENTER) run_nmap_profile "${NMAP_PROFILES[$selected]}"; return 0 ;;
        esac
    done
}

show_tool_details() {
    local index="$1"
    case "${MF_TOOL_IDS[$index]}" in
        nmap) show_nmap_profiles ;;
        *)
            mf_ui_header 'TOOL DETAILS' "${MF_TOOL_NAMES[$index]}"
            mf_ui_text 'No interactive adapter is available for this tool yet.'
            mf_ui_footer 'Q / ENTER  Back' 'Q / ENTER  BACK'
            mf_read_key BACK
            ;;
    esac
}

main() {
    refresh_tools || exit 1
    mf_tool_ui_raw
    while :; do
        draw_catalog
        mf_read_key QUIT
        case "$MF_KEY" in
            EOF|QUIT) break ;;
            UP) ((SELECTED=(SELECTED+${#MENU_ITEMS[@]}-1)%${#MENU_ITEMS[@]})) ;;
            DOWN) ((SELECTED=(SELECTED+1)%${#MENU_ITEMS[@]})) ;;
            HOME) SELECTED=0 ;;
            END) SELECTED=$(("${#MENU_ITEMS[@]}"-1)) ;;
            HELP) mf_ui_help ;;
            DIGIT_*) number=${MF_KEY#DIGIT_}; if ((number>=1 && number<=${#MENU_ITEMS[@]})); then SELECTED=$((number-1)); fi ;;
            ENTER)
                if ((SELECTED < ${#MF_TOOL_IDS[@]})); then
                    show_tool_details "$SELECTED"
                    mf_tool_ui_raw
                elif ((SELECTED == ${#MF_TOOL_IDS[@]})); then
                    refresh_tools || exit 1
                elif ((SELECTED == ${#MF_TOOL_IDS[@]}+1)); then
                    mf_ui_help
                    mf_tool_ui_raw
                else
                    break
                fi
                ;;
        esac
    done
    mf_restore_terminal
}
main "$@"
